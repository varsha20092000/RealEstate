@{
    ViewData["Title"] = "Agent Dashboard";
    var token = ViewBag.Token as string ?? "";
}

<style>
    .stat-card {
        cursor: pointer;
        transition: all 0.25s ease;
        border-bottom: 3px solid transparent;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
        }

        .stat-card.active {
            border-bottom: 3px solid #2563eb;
            background: #eff6ff !important;
        }

    .stat-card-inquiries:hover, .stat-card-inquiries.active {
        border-bottom-color: #f59e0b;
        background: #fffbeb !important;
    }

    .stat-card-bookings:hover, .stat-card-bookings.active {
        border-bottom-color: #10b981;
        background: #f0fdf4 !important;
    }

    .stat-card-portfolio:hover {
        border-bottom-color: #ef4444;
    }

    .section-panel {
        display: none;
    }

        .section-panel.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .prop-row {
        transition: background 0.15s;
        border-radius: 8px;
        padding: 10px 12px;
        margin-bottom: 6px;
        border: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .prop-row:hover {
            background: #eff6ff;
            border-color: #93c5fd;
        }

    .section-tab {
        border-radius: 10px;
        margin-bottom: 16px;
    }
</style>

<div class="bg-primary text-white py-4">
    <div class="container">
        <h3 class="fw-bold mb-0"><i class="fas fa-tachometer-alt me-2"></i>Agent Dashboard</h3>
        <p class="mb-0 opacity-75">Welcome back, @ViewBag.FullName!</p>
    </div>
</div>

<div class="container py-4">

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-4 stat-card stat-card-properties" onclick="showSection('properties')">
                <i class="fas fa-building fa-2x text-primary mb-2"></i>
                <h3 class="fw-bold" id="propCount">0</h3>
                <p class="text-muted mb-0 small">My Properties</p>
                <small class="text-primary mt-1" style="font-size:11px">Click to view →</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-4 stat-card stat-card-inquiries" onclick="showSection('inquiries')">
                <i class="fas fa-envelope fa-2x text-warning mb-2"></i>
                <h3 class="fw-bold" id="inqCount">0</h3>
                <p class="text-muted mb-0 small">Inquiries</p>
                <small class="text-warning mt-1" style="font-size:11px">Click to view →</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-4 stat-card stat-card-bookings" onclick="showSection('bookings')">
                <i class="fas fa-calendar fa-2x text-success mb-2"></i>
                <h3 class="fw-bold" id="bookCount">0</h3>
                <p class="text-muted mb-0 small">Visit Bookings</p>
                <small class="text-success mt-1" style="font-size:11px">Click to view →</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-4 stat-card stat-card-portfolio">
                <i class="fas fa-rupee-sign fa-2x text-danger mb-2"></i>
                <h3 class="fw-bold" id="portfolioValue">—</h3>
                <p class="text-muted mb-0 small">Portfolio Value</p>
            </div>
        </div>
    </div>

    <!-- SECTION: PROPERTIES -->
    <div id="section-properties" class="section-panel card border-0 shadow-sm section-tab">
        <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
            <span><i class="fas fa-building me-2 text-primary"></i>My Properties</span>
            <button class="btn btn-sm btn-primary" onclick="toggleForm()">+ Add Property</button>
        </div>
        <div id="addPropertyForm" style="display:none;" class="px-4 pt-3 pb-1 bg-light border-bottom">
            <div class="row g-2">
                <div class="col-md-6"><input type="text" class="form-control form-control-sm" id="title" placeholder="Title" /></div>
                <div class="col-md-6"><input type="text" class="form-control form-control-sm" id="city" placeholder="City" /></div>
                <div class="col-12"><textarea class="form-control form-control-sm" id="description" rows="2" placeholder="Description"></textarea></div>
                <div class="col-md-3"><input type="number" class="form-control form-control-sm" id="price" placeholder="Price" /></div>
                <div class="col-md-3"><input type="number" class="form-control form-control-sm" id="areaSqFt" placeholder="Area SqFt" /></div>
                <div class="col-md-3"><input type="number" class="form-control form-control-sm" id="bedrooms" placeholder="Bedrooms" /></div>
                <div class="col-md-3"><input type="number" class="form-control form-control-sm" id="bathrooms" placeholder="Bathrooms" /></div>
                <div class="col-md-6"><input type="text" class="form-control form-control-sm" id="address" placeholder="Address" /></div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" id="propertyType">
                        <option value="Villa">Villa</option>
                        <option value="Apartment">Apartment</option>
                        <option value="House">House</option>
                        <option value="Plot">Plot</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" id="listingType">
                        <option value="Sale">Sale</option>
                        <option value="Rent">Rent</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-center">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isFeatured" />
                        <label class="form-check-label fw-bold text-primary" for="isFeatured">⭐ Featured</label>
                    </div>
                </div>
                <div class="col-12 pb-3">
                    <button class="btn btn-sm btn-primary" onclick="addProperty()">
                        <i class="fas fa-save me-1"></i>Save Property
                    </button>
                    <span id="addResult" class="ms-2"></span>
                </div>
                <div id="uploadImageSection" style="display:none;" class="col-12 pb-3">
                    <hr class="mt-0" />
                    <h6 class="fw-bold">Upload Property Image</h6>
                    <div class="d-flex gap-2">
                        <input type="file" class="form-control form-control-sm" id="imageFile" accept="image/*" />
                        <button class="btn btn-sm btn-outline-primary" onclick="uploadImage()">
                            <i class="fas fa-upload me-1"></i>Upload
                        </button>
                    </div>
                    <div id="uploadResult" class="mt-2"></div>
                </div>
            </div>
        </div>
        <div class="card-body" id="propertiesList">
            <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
        </div>
    </div>

    <!-- SECTION: INQUIRIES -->
    <div id="section-inquiries" class="section-panel card border-0 shadow-sm section-tab">
        <div class="card-header bg-white fw-bold">
            <i class="fas fa-envelope me-2 text-warning"></i>Recent Inquiries
        </div>
        <div class="card-body" id="inquiriesList">
            <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
        </div>
    </div>

    <!-- SECTION: BOOKINGS -->
    <div id="section-bookings" class="section-panel card border-0 shadow-sm section-tab">
        <div class="card-header bg-white fw-bold">
            <i class="fas fa-calendar me-2 text-success"></i>Visit Bookings
        </div>
        <div class="card-body" id="bookingsList">
            <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
        </div>
    </div>

    <!-- ANALYTICS -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white fw-bold">
            <i class="fas fa-chart-line me-2 text-primary"></i>Analytics
            <span class="badge bg-primary ms-2">Live Data</span>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <h6 class="fw-bold text-muted mb-3"><i class="fas fa-chart-line me-2 text-primary"></i>Monthly Inquiries (Last 6 Months)</h6>
                    <canvas id="monthlyChart" height="200"></canvas>
                </div>
                <div class="col-md-6">
                    <h6 class="fw-bold text-muted mb-3"><i class="fas fa-chart-bar me-2 text-warning"></i>Inquiries per Property</h6>
                    <canvas id="inquiryChart" height="200"></canvas>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-muted mb-3"><i class="fas fa-chart-pie me-2 text-success"></i>Property Type Distribution</h6>
                    <canvas id="typeChart" height="200"></canvas>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-muted mb-3"><i class="fas fa-chart-bar me-2 text-danger"></i>Booking Status</h6>
                    <canvas id="bookingChart" height="200"></canvas>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-muted mb-3"><i class="fas fa-circle-notch me-2 text-info"></i>Inquiry Status</h6>
                    <canvas id="inquiryStatusChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>
    <!-- EDIT PROPERTY MODAL -->
    <div class="modal fade" id="editModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-edit me-2"></i>Edit Property</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editId" />
                    <input type="hidden" id="editAgentId" />
                    <div class="row g-2">
                        <div class="col-md-6"><label class="form-label small fw-bold">Title</label><input type="text" class="form-control form-control-sm" id="editTitle" /></div>
                        <div class="col-md-6"><label class="form-label small fw-bold">City</label><input type="text" class="form-control form-control-sm" id="editCity" /></div>
                        <div class="col-12"><label class="form-label small fw-bold">Description</label><textarea class="form-control form-control-sm" id="editDescription" rows="2"></textarea></div>
                        <div class="col-md-3"><label class="form-label small fw-bold">Price (₹)</label><input type="number" class="form-control form-control-sm" id="editPrice" /></div>
                        <div class="col-md-3"><label class="form-label small fw-bold">Area SqFt</label><input type="number" class="form-control form-control-sm" id="editAreaSqFt" /></div>
                        <div class="col-md-3"><label class="form-label small fw-bold">Bedrooms</label><input type="number" class="form-control form-control-sm" id="editBedrooms" /></div>
                        <div class="col-md-3"><label class="form-label small fw-bold">Bathrooms</label><input type="number" class="form-control form-control-sm" id="editBathrooms" /></div>
                        <div class="col-md-6"><label class="form-label small fw-bold">Address</label><input type="text" class="form-control form-control-sm" id="editAddress" /></div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Property Type</label>
                            <select class="form-select form-select-sm" id="editPropertyType">
                                <option value="Villa">Villa</option>
                                <option value="Apartment">Apartment</option>
                                <option value="House">House</option>
                                <option value="Plot">Plot</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Listing Type</label>
                            <select class="form-select form-select-sm" id="editListingType">
                                <option value="Sale">Sale</option>
                                <option value="Rent">Rent</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Status</label>
                            <select class="form-select form-select-sm" id="editStatus">
                                <option value="Available">Available</option>
                                <option value="Sold">Sold</option>
                                <option value="Rented">Rented</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end pb-1">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="editIsFeatured" />
                                <label class="form-check-label fw-bold text-primary" for="editIsFeatured">⭐ Featured</label>
                            </div>
                        </div>
                    </div>
                    <div id="editResult" class="mt-3"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveEdit()">
                        <i class="fas fa-save me-1"></i>Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        // Clear dashboard badge when agent visits dashboard
            localStorage.setItem('dashUnread', '0');
            const dashBadge = document.getElementById('dashboardBadge');
            if (dashBadge) dashBadge.style.display = 'none';
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const token = "@token";
        const properties = @Html.Raw(ViewBag.PropertiesJson != null ?
                    System.Text.Json.JsonSerializer.Serialize(
                            System.Text.Json.JsonDocument.Parse(
                                    ViewBag.PropertiesJson).RootElement.GetProperty("data")) : "[]");
    const inquiries = @Html.Raw(ViewBag.InquiriesJson ?? "[]");
    const bookings  = @Html.Raw(ViewBag.BookingsJson ?? "[]");

        document.getElementById('propCount').textContent  = properties.length;
        document.getElementById('inqCount').textContent   = inquiries.length;
        document.getElementById('bookCount').textContent  = bookings.length;

        function showSection(name) {
            ['properties','inquiries','bookings'].forEach(s => {
                document.getElementById('section-'+s).classList.remove('active');
            });
            document.querySelectorAll('.stat-card').forEach(c => c.classList.remove('active'));
            const map = { properties: 0, inquiries: 1, bookings: 2 };
            document.getElementById('section-'+name).classList.add('active');
            document.querySelectorAll('.stat-card')[map[name]].classList.add('active');
            document.getElementById('section-'+name).scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        if (properties.length > 0) {
            document.getElementById('propertiesList').innerHTML = properties.map(p => `
                <div class="prop-row">
                    <div onclick="window.location='/Home/PropertyDetail/${p.id}'" style="flex:1;cursor:pointer;">
                        <p class="fw-bold mb-0">${p.title}</p>
                        <small class="text-muted">
                            <i class="fas fa-map-marker-alt me-1 text-primary"></i>${p.city} &bull; ₹${p.price.toLocaleString('en-IN')}
                        </small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-${p.status === 'Available' ? 'success' : 'secondary'}">${p.status}</span>
                            <button class="btn btn-sm btn-outline-primary" title="Edit Property"
                                onclick="openEditModal(event, ${JSON.stringify(p).replace(/"/g, '&quot;')})">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" title="Delete Property"
                                onclick="deleteProperty(event, '${p.id}', '${p.title.replace(/'/g, "\\'")}')">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        <i class="fas fa-chevron-right text-muted small"
                            onclick="window.location='/Home/PropertyDetail/${p.id}'"
                            style="cursor:pointer;"></i>
                    </div>
                </div>`).join('');
        } else {
            document.getElementById('propertiesList').innerHTML = '<p class="text-muted text-center py-3">No properties yet!</p>';
        }

        if (inquiries.length > 0) {
            document.getElementById('inquiriesList').innerHTML = inquiries.map(i => `
                <div class="border-bottom pb-2 mb-2">
                    <p class="fw-bold mb-1 small">${i.message}</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge ${i.isReplied ? 'bg-success' : 'bg-warning text-dark'}">
                            ${i.isReplied ? 'Replied' : 'Pending'}
                        </span>
                        ${!i.isReplied ? `<button class="btn btn-sm btn-outline-primary" onclick="replyInquiry('${i.id}')">Reply</button>` : ''}
                    </div>
                </div>`).join('');
        } else {
            document.getElementById('inquiriesList').innerHTML = '<p class="text-muted text-center py-3">No inquiries yet!</p>';
        }

        if (bookings.length > 0) {
            document.getElementById('bookingsList').innerHTML = `
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Visit Date</th><th>Notes</th><th>Status</th><th>Action</th></tr></thead>
                        <tbody>
                            ${bookings.map(b => `
                            <tr>
                                <td>${new Date(b.visitDate).toLocaleDateString()}</td>
                                <td>${b.notes ?? '-'}</td>
                                <td><span class="badge ${b.status==='Confirmed'?'bg-success':b.status==='Cancelled'?'bg-danger':'bg-warning text-dark'}">${b.status}</span></td>
                                <td>${b.status==='Pending'?`<button class="btn btn-sm btn-success" onclick="confirmBooking('${b.id}')">Confirm</button>`:'-'}</td>
                            </tr>`).join('')}
                        </tbody>
                    </table>
                </div>`;
        } else {
            document.getElementById('bookingsList').innerHTML = '<p class="text-muted text-center py-3">No bookings yet!</p>';
        }

        async function loadAnalytics() {
            try {
                const r = await fetch('https://localhost:7056/api/Agents/analytics', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (!r.ok) return;
                const d = await r.json();
                document.getElementById('portfolioValue').textContent =
                    '₹' + (d.totalValue / 10000000).toFixed(1) + 'Cr';
                new Chart(document.getElementById('monthlyChart'), {
                    type: 'line',
                    data: {
                        labels: d.monthlyInquiries.map(m => m.month),
                        datasets: [{ label:'Inquiries', data: d.monthlyInquiries.map(m=>m.count),
                            borderColor:'#2563eb', backgroundColor:'rgba(37,99,235,0.1)',
                            fill:true, tension:0.4, pointBackgroundColor:'#2563eb', pointRadius:5 }]
                    },
                    options: { responsive:true, plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true,ticks:{stepSize:1}}} }
                });
                new Chart(document.getElementById('inquiryChart'), {
                    type:'bar',
                    data: {
                        labels: d.inquiriesPerProperty.map(p=>p.propertyTitle),
                        datasets:[{ data: d.inquiriesPerProperty.map(p=>p.inquiryCount),
                            backgroundColor:['#2563eb','#f59e0b','#10b981','#ef4444','#8b5cf6','#06b6d4','#f97316'],
                            borderRadius:6 }]
                    },
                    options: { responsive:true, plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true,ticks:{stepSize:1}}} }
                });
                new Chart(document.getElementById('typeChart'), {
                    type:'pie',
                    data: {
                        labels: d.propertyTypeDistribution.map(t=>t.type),
                        datasets:[{ data: d.propertyTypeDistribution.map(t=>t.count),
                            backgroundColor:['#2563eb','#f59e0b','#10b981','#ef4444'], borderWidth:2, borderColor:'#fff' }]
                    },
                    options:{ responsive:true, plugins:{legend:{position:'bottom'}} }
                });
                new Chart(document.getElementById('bookingChart'), {
                    type:'bar',
                    data: {
                        labels:['Pending','Confirmed','Cancelled'],
                        datasets:[{ data:[d.bookingStats.pending,d.bookingStats.confirmed,d.bookingStats.cancelled],
                            backgroundColor:['#f59e0b','#10b981','#ef4444'], borderRadius:6 }]
                    },
                    options:{ responsive:true, plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true,ticks:{stepSize:1}}} }
                });
                new Chart(document.getElementById('inquiryStatusChart'), {
                    type:'doughnut',
                    data: {
                        labels:['Replied','Pending'],
                        datasets:[{ data:[d.repliedInquiries,d.pendingInquiries],
                            backgroundColor:['#10b981','#f59e0b'], borderWidth:2, borderColor:'#fff' }]
                    },
                    options:{ responsive:true, plugins:{legend:{position:'bottom'}} }
                });
            } catch(e){ console.error(e); }
        }
        loadAnalytics();

        function toggleForm() {
            const f = document.getElementById('addPropertyForm');
            f.style.display = f.style.display==='none' ? 'block' : 'none';
        }

        let newPropertyId = null;

        async function addProperty() {
            const property = {
                title: document.getElementById('title').value,
                description: document.getElementById('description').value,
                price: parseFloat(document.getElementById('price').value),
                areaSqFt: parseFloat(document.getElementById('areaSqFt').value),
                bedrooms: parseInt(document.getElementById('bedrooms').value),
                bathrooms: parseInt(document.getElementById('bathrooms').value),
                address: document.getElementById('address').value,
                city: document.getElementById('city').value,
                propertyType: document.getElementById('propertyType').value,
                listingType: document.getElementById('listingType').value,
                isFeatured: document.getElementById('isFeatured').checked,
                latitude: 0, longitude: 0
            };
            const r = await fetch('https://localhost:7056/api/Properties', {
                method:'POST',
                headers:{'Content-Type':'application/json','Authorization':`Bearer ${token}`},
                body: JSON.stringify(property)
            });
            if (r.ok) {
                const data = await r.json();
                newPropertyId = data.id;
                document.getElementById('addResult').innerHTML = '<span class="text-success">✅ Property added!</span>';
                document.getElementById('uploadImageSection').style.display = 'block';
            } else {
                document.getElementById('addResult').innerHTML = '<span class="text-danger">❌ Failed!</span>';
            }
        }

        async function uploadImage() {
            const fileInput = document.getElementById('imageFile');
            if (!fileInput.files[0]) { alert('Please select an image!'); return; }
            if (!newPropertyId) { alert('Save property first!'); return; }
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            const r = await fetch(`https://localhost:7056/api/Properties/${newPropertyId}/images`, {
                method:'POST', headers:{'Authorization':`Bearer ${token}`}, body: formData
            });
            if (r.ok) {
                document.getElementById('uploadResult').innerHTML = '<div class="alert alert-success py-1">✅ Image uploaded!</div>';
                setTimeout(() => location.reload(), 1500);
            }
        }

        async function deleteProperty(event, propertyId, title) {
            event.stopPropagation();
            if (!confirm(`Delete "${title}"? This will also delete all images and cannot be undone.`)) return;
            const btn = event.currentTarget;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            try {
                const r = await fetch(`https://localhost:7056/api/Properties/${propertyId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (r.ok) {
                    btn.closest('.prop-row').remove();
                    const remaining = document.querySelectorAll('.prop-row').length;
                    document.getElementById('propCount').textContent = remaining;
                    if (remaining === 0) {
                        document.getElementById('propertiesList').innerHTML =
                            '<p class="text-muted text-center py-3">No properties yet!</p>';
                    }
                } else {
                    alert('Failed to delete property.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-trash-alt"></i>';
                }
            } catch(e) {
                alert('Error deleting property.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-trash-alt"></i>';
            }
        }

        async function confirmBooking(id) {
            const r = await fetch(`https://localhost:7056/api/VisitBookings/${id}/confirm`, {
                method:'PUT', headers:{'Authorization':`Bearer ${token}`}
            });
            if (r.ok) location.reload();
        }

        async function replyInquiry(id) {
            const reply = prompt('Enter your reply:');
            if (!reply) return;
            const r = await fetch(`https://localhost:7056/api/Inquiries/${id}/reply`, {
                method:'PUT',
                headers:{'Content-Type':'application/json','Authorization':`Bearer ${token}`},
                body: JSON.stringify(reply)
            });
            if (r.ok) location.reload();
        }
            function openEditModal(event, p) {
                event.stopPropagation();
                document.getElementById('editId').value          = p.id;
                document.getElementById('editAgentId').value     = p.agentId ?? '';
                document.getElementById('editTitle').value       = p.title;
                document.getElementById('editCity').value        = p.city;
                document.getElementById('editDescription').value = p.description;
                document.getElementById('editPrice').value       = p.price;
                document.getElementById('editAreaSqFt').value    = p.areaSqFt;
                document.getElementById('editBedrooms').value    = p.bedrooms;
                document.getElementById('editBathrooms').value   = p.bathrooms;
                document.getElementById('editAddress').value     = p.address;
                document.getElementById('editPropertyType').value = p.propertyType;
                document.getElementById('editListingType').value  = p.listingType;
                document.getElementById('editStatus').value       = p.status;
                document.getElementById('editIsFeatured').checked = p.isFeatured;
                document.getElementById('editResult').innerHTML   = '';
                new bootstrap.Modal(document.getElementById('editModal')).show();
            }

            async function saveEdit() {
                const id = document.getElementById('editId').value;
                const body = {
                    id:           id,
                    title:        document.getElementById('editTitle').value,
                    description:  document.getElementById('editDescription').value,
                    price:        parseFloat(document.getElementById('editPrice').value),
                    areaSqFt:     parseFloat(document.getElementById('editAreaSqFt').value),
                    bedrooms:     parseInt(document.getElementById('editBedrooms').value),
                    bathrooms:    parseInt(document.getElementById('editBathrooms').value),
                    address:      document.getElementById('editAddress').value,
                    city:         document.getElementById('editCity').value,
                    propertyType: document.getElementById('editPropertyType').value,
                    listingType:  document.getElementById('editListingType').value,
                    status:       document.getElementById('editStatus').value,
                    isFeatured:   document.getElementById('editIsFeatured').checked,
                    agentId:      document.getElementById('editAgentId').value || null,
                    latitude: 0, longitude: 0
                };
                const r = await fetch(`https://localhost:7056/api/Properties/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify(body)
                });
                if (r.ok) {
                    document.getElementById('editResult').innerHTML =
                        '<div class="alert alert-success py-1">✅ Property updated!</div>';
                    setTimeout(() => location.reload(), 1500);
                } else {
                    document.getElementById('editResult').innerHTML =
                        '<div class="alert alert-danger py-1">❌ Failed to update. Status: ' + r.status + '</div>';
                }
            }
    </script>
}