@{
    ViewData["Title"] = "Admin Dashboard";
    var token = ViewBag.Token as string ?? "";
}

<style>
    .stat-card-admin {
        cursor: pointer;
        transition: all 0.25s ease;
        border-bottom: 3px solid transparent !important;
    }

        .stat-card-admin:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.12) !important;
        }

    .section-panel {
        display: none;
        animation: slideDown 0.3s ease;
    }

        .section-panel.show {
            display: block;
        }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="bg-danger text-white py-4">
    <div class="container">
        <h3 class="fw-bold mb-0"><i class="fas fa-crown me-2"></i>Admin Dashboard</h3>
        <p class="mb-0 opacity-75">Full control panel</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">

        <!-- Stats Cards -->
        <div class="col-12">
            <div class="row g-3">
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3 stat-card-admin"
                         onclick="togglePanel('properties')"
                         style="border-bottom-color:#2563eb !important;">
                        <i class="fas fa-building fa-2x text-primary mb-2"></i>
                        <h4 class="fw-bold" id="totalProperties">-</h4>
                        <small class="text-muted">Properties</small>
                        <small class="text-primary" style="font-size:10px;">Click to view ↓</small>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3 stat-card-admin"
                         onclick="togglePanel('users')"
                         style="border-bottom-color:#10b981 !important;">
                        <i class="fas fa-users fa-2x text-success mb-2"></i>
                        <h4 class="fw-bold" id="totalUsers">-</h4>
                        <small class="text-muted">Users</small>
                        <small class="text-success" style="font-size:10px;">Click to view ↓</small>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3 stat-card-admin"
                         onclick="togglePanel('agents')"
                         style="border-bottom-color:#f59e0b !important;">
                        <i class="fas fa-user-tie fa-2x text-warning mb-2"></i>
                        <h4 class="fw-bold" id="totalAgents">-</h4>
                        <small class="text-muted">Agents</small>
                        <small class="text-warning" style="font-size:10px;">Click to view ↓</small>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3 stat-card-admin"
                         onclick="togglePanel('inquiries')"
                         style="border-bottom-color:#06b6d4 !important;">
                        <i class="fas fa-envelope fa-2x text-info mb-2"></i>
                        <h4 class="fw-bold" id="totalInquiries">-</h4>
                        <small class="text-muted">Inquiries</small>
                        <small class="text-info" style="font-size:10px;">Click to view ↓</small>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3 stat-card-admin"
                         onclick="togglePanel('bookings')"
                         style="border-bottom-color:#6b7280 !important;">
                        <i class="fas fa-calendar fa-2x text-secondary mb-2"></i>
                        <h4 class="fw-bold" id="totalBookings">-</h4>
                        <small class="text-muted">Bookings</small>
                        <small class="text-secondary" style="font-size:10px;">Click to view ↓</small>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3 stat-card-admin"
                         onclick="togglePanel('reviews')"
                         style="border-bottom-color:#ef4444 !important;">
                        <i class="fas fa-star fa-2x text-danger mb-2"></i>
                        <h4 class="fw-bold" id="totalReviews">-</h4>
                        <small class="text-muted">Reviews</small>
                        <small class="text-danger" style="font-size:10px;">Click to view ↓</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Properties Panel -->
        <div class="col-12 section-panel" id="panel-properties">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold d-flex justify-content-between">
                    <span><i class="fas fa-building me-2 text-primary"></i>All Properties</span>
                    <button class="btn btn-sm btn-outline-secondary" onclick="togglePanel('properties')">✕ Close</button>
                </div>
                <div class="card-body" id="propertiesPanel">
                    <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                </div>
            </div>
        </div>

        <!-- Users Panel -->
        <div class="col-12 section-panel show" id="panel-users">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold d-flex justify-content-between">
                    <span><i class="fas fa-users me-2 text-success"></i>All Users</span>
                    <button class="btn btn-sm btn-outline-secondary" onclick="togglePanel('users')">✕ Close</button>
                </div>
                <div class="card-body" id="usersList">
                    <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                </div>
            </div>
        </div>

        <!-- Agents Panel -->
        <div class="col-12 section-panel" id="panel-agents">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold d-flex justify-content-between">
                    <span><i class="fas fa-user-tie me-2 text-warning"></i>Agents</span>
                    <button class="btn btn-sm btn-outline-secondary" onclick="togglePanel('agents')">✕ Close</button>
                </div>
                <div class="card-body" id="agentsList">
                    <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                </div>
            </div>
        </div>

        <!-- Inquiries Panel -->
        <div class="col-12 section-panel" id="panel-inquiries">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold d-flex justify-content-between">
                    <span><i class="fas fa-envelope me-2 text-info"></i>All Inquiries</span>
                    <button class="btn btn-sm btn-outline-secondary" onclick="togglePanel('inquiries')">✕ Close</button>
                </div>
                <div class="card-body" id="inquiriesPanel">
                    <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                </div>
            </div>
        </div>

        <!-- Bookings Panel -->
        <div class="col-12 section-panel" id="panel-bookings">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold d-flex justify-content-between">
                    <span><i class="fas fa-calendar me-2 text-secondary"></i>All Bookings</span>
                    <button class="btn btn-sm btn-outline-secondary" onclick="togglePanel('bookings')">✕ Close</button>
                </div>
                <div class="card-body" id="bookingsPanel">
                    <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                </div>
            </div>
        </div>

        <!-- Reviews Panel -->
        <div class="col-12 section-panel" id="panel-reviews">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold d-flex justify-content-between">
                    <span><i class="fas fa-star me-2 text-danger"></i>All Reviews</span>
                    <button class="btn btn-sm btn-outline-secondary" onclick="togglePanel('reviews')">✕ Close</button>
                </div>
                <div class="card-body" id="reviewsPanel">
                    <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const token  = "@token";
        const stats  = @Html.Raw(ViewBag.StatsJson ?? "null");
        const users  = @Html.Raw(ViewBag.UsersJson ?? "[]");
        const agents = @Html.Raw(ViewBag.AgentsJson ?? "[]");

        // Stats
        if (stats) {
            document.getElementById('totalProperties').textContent = stats.totalProperties;
            document.getElementById('totalUsers').textContent      = stats.totalUsers;
            document.getElementById('totalAgents').textContent     = stats.totalAgents;
            document.getElementById('totalInquiries').textContent  = stats.totalInquiries;
            document.getElementById('totalBookings').textContent   = stats.totalBookings;
            document.getElementById('totalReviews').textContent    = stats.totalReviews;
        }

        // Toggle panels
        function togglePanel(name) {
            const panel  = document.getElementById('panel-' + name);
            const isOpen = panel.classList.contains('show');
            document.querySelectorAll('.section-panel').forEach(p => p.classList.remove('show'));
            if (!isOpen) {
                panel.classList.add('show');
                setTimeout(() => panel.scrollIntoView({ behavior:'smooth', block:'start' }), 50);
                loadPanelData(name);
            }
        }

        // Load data for each panel
        async function loadPanelData(name) {
            if (name === 'users')       renderUsers();
            if (name === 'agents')      renderAgents();
            if (name === 'properties')  await loadProperties();
            if (name === 'inquiries')   await loadInquiries();
            if (name === 'bookings')    await loadBookings();
            if (name === 'reviews')     await loadReviews();
        }

        // Users
        function renderUsers() {
            if (users.length > 0) {
                document.getElementById('usersList').innerHTML = `
                    <div class="table-responsive">
                        <table class="table table-hover table-sm">
                            <thead><tr><th>Name</th><th>Email</th><th>Status</th></tr></thead>
                            <tbody>
                                ${users.map(u => `
                                <tr>
                                    <td class="fw-bold">${u.fullName}</td>
                                    <td class="small text-muted">${u.email}</td>
                                    <td><span class="badge ${u.isActive?'bg-success':'bg-secondary'}">${u.isActive?'Active':'Inactive'}</span></td>
                                </tr>`).join('')}
                            </tbody>
                        </table>
                    </div>`;
            } else {
                document.getElementById('usersList').innerHTML = '<p class="text-muted text-center">No users found!</p>';
            }
        }
        renderUsers();

        // Agents
        function renderAgents() {
            if (agents.length > 0) {
                document.getElementById('agentsList').innerHTML = agents.map(a => `
                    <div class="border-bottom pb-2 mb-2 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="fw-bold mb-0 small">${a.agencyName}</p>
                            <small class="text-muted">${a.licenseNumber} • ${a.specialization}</small>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="badge ${a.isApproved?'bg-success':'bg-warning text-dark'}">${a.isApproved?'Approved':'Pending'}</span>
                            ${!a.isApproved ? `<button class="btn btn-sm btn-success" onclick="approveAgent('${a.id}')">Approve</button>` : ''}
                        </div>
                    </div>`).join('');
            } else {
                document.getElementById('agentsList').innerHTML = '<p class="text-muted text-center">No agents found!</p>';
            }
        }

        // Properties
        async function loadProperties() {
            try {
                const r = await fetch('https://localhost:7056/api/Properties/search?pageSize=50', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await r.json();
                const props = data.data || [];
                document.getElementById('propertiesPanel').innerHTML = props.length > 0
                    ? `<div class="table-responsive">
                        <table class="table table-hover table-sm">
                            <thead><tr><th>Title</th><th>City</th><th>Price</th><th>Type</th><th>Status</th><th>Action</th></tr></thead>
                            <tbody>
                                ${props.map(p => `
                               <tr>
                                    <td class="fw-bold small" style="cursor:pointer;" onclick="window.location='/Home/PropertyDetail/${p.id}'">${p.title}</td>
                                    <td class="small text-muted">${p.city}</td>
                                    <td class="small">₹${p.price.toLocaleString('en-IN')}</td>
                                    <td><span class="badge bg-primary">${p.propertyType}</span></td>
                                    <td><span class="badge ${p.status==='Available'?'bg-success':'bg-secondary'}">${p.status}</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteProperty('${p.id}','${p.title.replace(/'/g,"\\'")}')">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>`).join('')}
                            </tbody>
                        </table>
                    </div>`
                    : '<p class="text-muted text-center">No properties!</p>';
            } catch(e) { console.error(e); }
        }

        // Inquiries
        async function loadInquiries() {
            try {
                const r = await fetch('https://localhost:7056/api/Inquiries', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const inqs = await r.json();
                document.getElementById('inquiriesPanel').innerHTML = inqs.length > 0
                    ? inqs.map(i => `
                        <div class="border-bottom pb-2 mb-2">
                            <p class="fw-bold mb-1 small">${i.message}</p>
                            <div class="d-flex justify-content-between">
                                <span class="badge ${i.isReplied?'bg-success':'bg-warning text-dark'}">${i.isReplied?'Replied':'Pending'}</span>
                                <small class="text-muted">${new Date(i.createdAt).toLocaleDateString()}</small>
                            </div>
                            ${i.reply ? `<p class="text-success small mt-1">Reply: ${i.reply}</p>` : ''}
                        </div>`).join('')
                    : '<p class="text-muted text-center">No inquiries!</p>';
            } catch(e) { console.error(e); }
        }

        // Bookings
        async function loadBookings() {
            try {
                const r = await fetch('https://localhost:7056/api/VisitBookings', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const bookings = await r.json();
                document.getElementById('bookingsPanel').innerHTML = bookings.length > 0
                    ? `<div class="table-responsive">
                        <table class="table table-hover table-sm">
                            <thead><tr><th>Visit Date</th><th>Notes</th><th>Status</th></tr></thead>
                            <tbody>
                                ${bookings.map(b => `
                                <tr>
                                    <td>${new Date(b.visitDate).toLocaleDateString()}</td>
                                    <td class="small text-muted">${b.notes??'-'}</td>
                                    <td><span class="badge ${b.status==='Confirmed'?'bg-success':b.status==='Cancelled'?'bg-danger':'bg-warning text-dark'}">${b.status}</span></td>
                                </tr>`).join('')}
                            </tbody>
                        </table>
                    </div>`
                    : '<p class="text-muted text-center">No bookings!</p>';
            } catch(e) { console.error(e); }
        }

        // Reviews
        async function loadReviews() {
            try {
                const r    = await fetch('https://localhost:7056/api/Reviews');
                const revs = await r.json();
                const stars = (n) => [1,2,3,4,5].map(i =>
                    `<i class="fas fa-star" style="color:${i<=n?'#f59e0b':'#e2e8f0'};font-size:12px;"></i>`).join('');

               document.getElementById('reviewsPanel').innerHTML = revs.length > 0
                    ? `<div class="table-responsive">
                        <table class="table table-hover table-sm">
                            <thead>
                                <tr>
                                    <th>Reviewer</th>
                                    <th>Rating</th>
                                    <th>Comment</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${revs.map(rv => {
                                    const reviewer = users.find(u => u.id === rv.reviewerId);
                                    const reviewerName = reviewer ? reviewer.fullName : 'Unknown';
                                    const starsHtml = [1,2,3,4,5].map(i =>
                                        `<i class="fas fa-star" style="color:${i<=rv.rating?'#f59e0b':'#e2e8f0'};font-size:11px;"></i>`).join('');
                                    return `<tr>
                                        <td class="fw-bold small">${reviewerName}</td>
                                        <td>${starsHtml}</td>
                                        <td class="small text-muted">${rv.comment}</td>
                                        <td class="small text-muted">${new Date(rv.createdAt).toLocaleDateString()}</td>
                                        <td><span class="badge ${rv.isApproved?'bg-success':'bg-warning text-dark'}">${rv.isApproved?'Approved':'Pending'}</span></td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                ${!rv.isApproved ? `<button class="btn btn-sm btn-success" onclick="approveReview('${rv.id}')">✓</button>` : ''}
                                                <button class="btn btn-sm btn-outline-danger" onclick="deleteReview('${rv.id}')"><i class="fas fa-trash-alt"></i></button>
                                            </div>
                                        </td>
                                    </tr>`;
                                }).join('')}
                            </tbody>
                        </table>
                    </div>`
                    : '<p class="text-muted text-center">No reviews yet!</p>';
            } catch(e) { console.error(e); }
        }

        async function approveAgent(id) {
            const r = await fetch('https://localhost:7056/api/Admin/agents/' + id + '/approve', {
                method: 'PUT', headers: { 'Authorization': 'Bearer ' + token }
            });
            if (r.ok) location.reload();
        }

        async function approveReview(id) {
            const r = await fetch('https://localhost:7056/api/Reviews/' + id + '/approve', {
                method: 'PUT', headers: { 'Authorization': 'Bearer ' + token }
            });
            if (r.ok) loadReviews();
            else alert('Approve failed — endpoint may not exist yet.');
        }

        async function deleteReview(id) {
            if (!confirm('Delete this review?')) return;
            const r = await fetch('https://localhost:7056/api/Reviews/' + id, {
                method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token }
            });
            if (r.ok) loadReviews();
        }

        // Open users by default
        document.getElementById('panel-users').classList.add('show');
        renderUsers();
        async function deleteProperty(id, title) {
            if (!confirm('Delete "' + title + '"? This cannot be undone.')) return;
            const r = await fetch('https://localhost:7056/api/Properties/' + id, {
                method: 'DELETE',
                headers: { 'Authorization': 'Bearer ' + token }
            });
            if (r.ok) {
                await loadProperties();
                if (stats) document.getElementById('totalProperties').textContent =
                    parseInt(document.getElementById('totalProperties').textContent) - 1;
            } else {
                alert('Failed to delete property.');
            }
        }
    </script>
}