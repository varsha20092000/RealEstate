@{
    ViewData["Title"] = "My Favorites";
    var token = ViewBag.Token as string ?? "";
}
<div class="bg-primary text-white py-4">
    <div class="container">
        <h3 class="fw-bold mb-0">
            <i class="fas fa-heart me-2"></i>My Favorites
        </h3>
    </div>
</div>
<div class="container py-5">
    <div class="row g-4" id="favoritesList">
        <div class="col-12 text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted">Loading favorites...</p>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const token = "@token";
        const favorites = @Html.Raw(ViewBag.FavoritesJson ?? "[]");

        async function loadFavorites() {
            if (favorites.length === 0) {
                document.getElementById('favoritesList').innerHTML = `
                    <div class="col-12 text-center py-5">
                        <i class="fas fa-heart fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No favorites yet!</h5>
                        <a href="/Home/Properties" class="btn btn-primary mt-2">Browse Properties</a>
                    </div>`;
                return;
            }

            // Fetch full property details for each favorite
            const cards = await Promise.all(favorites.map(async f => {
                try {
                    const res = await fetch('https://localhost:7056/api/Properties/' + f.propertyId);
                    const p = await res.json();

                    // Get image
                    let imgHtml = '<div style="height:200px;background:linear-gradient(135deg,#e2e8f0,#cbd5e1);display:flex;align-items:center;justify-content:center;"><i class="fas fa-home fa-3x text-secondary"></i></div>';
                    const imageUrl = (p.images && p.images.length > 0)
                        ? p.images[0].imageUrl
                        : (p.imageUrls && p.imageUrls.length > 0 ? p.imageUrls[0] : null);
                    if (imageUrl) {
                        const src = imageUrl.startsWith('http') ? imageUrl : 'https://localhost:7056' + imageUrl;
                        imgHtml = '<img src="' + src + '" style="width:100%;height:200px;object-fit:cover;" onerror="this.parentElement.innerHTML=\'<div style=height:200px;background:#e2e8f0;display:flex;align-items:center;justify-content:center;><i class=fas fa-home fa-3x text-secondary></i></div>\'" />';
                    }

                    return `
                        <div class="col-md-4">
                            <div class="card shadow-sm h-100" style="border-radius:12px;overflow:hidden;">
                                <div style="overflow:hidden;">
                                    ${imgHtml}
                                </div>
                                <div class="card-body">
                                    <h6 class="fw-bold mb-1">${p.title}</h6>
                                    <p class="text-muted small mb-1">
                                        <i class="fas fa-map-marker-alt me-1 text-primary"></i>${p.city}
                                    </p>
                                    <p class="fw-bold text-primary mb-1">₹${p.price.toLocaleString('en-IN')}</p>
                                    <p class="text-muted small mb-0">
                                        <i class="fas fa-calendar me-1"></i>Saved on ${new Date(f.savedAt).toLocaleDateString()}
                                    </p>
                                </div>
                                <div class="card-footer bg-white border-0 d-flex gap-2 pb-3">
                                    <a href="/Home/PropertyDetail/${f.propertyId}" class="btn btn-primary flex-grow-1">
                                        <i class="fas fa-eye me-1"></i>View Property
                                    </a>
                                    <button class="btn btn-outline-danger" onclick="removeFavorite('${f.id}')" title="Remove from favorites">
                                        <i class="fas fa-heart-broken"></i>
                                    </button>
                                </div>
                            </div>
                        </div>`;
                } catch(e) {
                    return ''; // skip if property fetch fails
                }
            }));

            const html = cards.filter(c => c).join('');
            document.getElementById('favoritesList').innerHTML = html || `
                <div class="col-12 text-center py-5">
                    <i class="fas fa-heart fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No favorites yet!</h5>
                    <a href="/Home/Properties" class="btn btn-primary mt-2">Browse Properties</a>
                </div>`;
        }

        loadFavorites();

        async function removeFavorite(id) {
            if (!confirm('Remove from favorites?')) return;
            const r = await fetch('https://localhost:7056/api/Favorites/' + id, {
                method: 'DELETE',
                headers: { 'Authorization': 'Bearer ' + token }
            });
            if (r.ok) location.reload();
        }
    </script>
}