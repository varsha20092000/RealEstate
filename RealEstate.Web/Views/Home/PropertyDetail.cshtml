@{
    ViewData["Title"] = "Property Detail";
    var isLoggedIn = ViewBag.IsLoggedIn ?? false;
    var token = ViewBag.Token as string ?? "";
    var userId = ViewBag.UserId as string ?? "";
    var userRole = ViewBag.UserRole as string ?? "";
}

<style>
    .carousel-wrapper {
        position: relative;
        background: #0f172a;
        border-radius: 16px;
        overflow: hidden;
        height: 420px;
    }

    .carousel-img {
        width: 100%;
        height: 420px;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.5s ease;
        position: absolute;
        top: 0;
        left: 0;
    }

        .carousel-img.active {
            opacity: 1;
        }

    .no-image-placeholder {
        height: 420px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,#1e293b,#334155);
        color: #94a3b8;
        border-radius: 16px;
    }

    .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.85);
        border: none;
        border-radius: 50%;
        width: 42px;
        height: 42px;
        font-size: 16px;
        cursor: pointer;
        z-index: 10;
        transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

        .carousel-btn:hover {
            background: white;
            transform: translateY(-50%) scale(1.1);
        }

        .carousel-btn.prev {
            left: 14px;
        }

        .carousel-btn.next {
            right: 14px;
        }

    .carousel-dots {
        position: absolute;
        bottom: 14px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 7px;
    }

    .carousel-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: rgba(255,255,255,0.5);
        cursor: pointer;
        transition: all 0.2s;
    }

        .carousel-dot.active {
            background: white;
            transform: scale(1.3);
        }

    .img-count-badge {
        position: absolute;
        top: 14px;
        right: 14px;
        background: rgba(0,0,0,0.55);
        color: white;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 20px;
        backdrop-filter: blur(4px);
    }

    .upload-zone {
        border: 2px dashed #93c5fd;
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        background: #eff6ff;
        cursor: pointer;
        transition: all 0.2s;
    }

        .upload-zone:hover {
            border-color: #2563eb;
            background: #dbeafe;
        }

        .upload-zone input[type=file] {
            display: none;
        }

    .detail-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.08);
        padding: 28px;
    }

    .price-tag {
        font-size: 2rem;
        font-weight: 800;
        color: #1e40af;
    }

    .spec-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 16px;
        text-align: center;
        border: 1px solid #e2e8f0;
        transition: all 0.2s;
    }

        .spec-box:hover {
            background: #eff6ff;
            border-color: #93c5fd;
            transform: translateY(-2px);
        }

    .action-card {
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        background: white;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .action-card-header {
        padding: 14px 18px;
        font-weight: 700;
        font-size: 15px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .action-card-body {
        padding: 18px;
    }

    #map {
        height: 220px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container py-4" style="max-width:1200px;">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Home/Properties">Properties</a></li>
            <li class="breadcrumb-item active" id="breadcrumbTitle">Loading...</li>
        </ol>
    </nav>
    <div id="loadingState" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">Loading property...</p>
    </div>
    <div id="propertyContent" style="display:none;">
        <div class="row g-4">
            <div class="col-lg-7">
                <div id="carouselContainer"></div>
                <div class="detail-card mt-4">
                    <h2 class="fw-bold mb-1" id="detailTitle"></h2>
                    <p class="text-muted mb-2" id="detailAddress"></p>
                    <div class="d-flex gap-2 mb-3" id="detailBadges"></div>
                    <div class="price-tag mb-3" id="detailPrice"></div>
                    <hr />
                    <h5 class="fw-bold mb-2">Description</h5>
                    <p class="text-muted" id="detailDesc"></p>
                    <hr />
                    <h5 class="fw-bold mb-3">Property Details</h5>
                    <div class="row g-3" id="detailSpecs"></div>
                </div>
                <div class="detail-card mt-4">
                    <h5 class="fw-bold mb-3"><i class="fas fa-map-marker-alt me-2 text-primary"></i>Location</h5>
                    <div id="map"></div>
                </div>
            </div>
            <div class="col-lg-5">
                <div id="uploadSection" style="display:none;" class="action-card mb-3">
                    <div class="action-card-header"><i class="fas fa-camera me-2 text-primary"></i>Add Property Images</div>
                    <div class="action-card-body">
                        <div class="upload-zone" onclick="document.getElementById('imgInput').click()">
                            <input type="file" id="imgInput" accept="image/*" multiple onchange="handleImageUpload(this)" />
                            <i class="fas fa-cloud-upload-alt fa-2x text-primary mb-2"></i>
                            <p class="mb-1 fw-bold">Click to upload images</p>
                            <small class="text-muted">JPG, PNG, WEBP • Multiple files allowed</small>
                        </div>
                        <div id="uploadProgress" class="mt-2"></div>
                    </div>
                </div>
                <div id="favoriteCard" class="action-card mb-3">
                    <div class="action-card-header"><i class="fas fa-heart me-2 text-danger"></i>Save Property</div>
                    <div class="action-card-body" id="favoriteSection"></div>
                </div>
                <div id="inquiryCard" class="action-card mb-3">
                    <div class="action-card-header"><i class="fas fa-envelope me-2 text-primary"></i>Send Inquiry</div>
                    <div class="action-card-body" id="inquirySection"></div>
                </div>
                <div id="visitCard" class="action-card mb-3">
                    <div class="action-card-header"><i class="fas fa-calendar me-2 text-success"></i>Book a Visit</div>
                    <div class="action-card-body" id="visitSection"></div>
                </div>
                <!-- Reviews Section -->
                <div id="reviewCard" class="action-card mb-3">
                    <div class="action-card-header"><i class="fas fa-star me-2 text-warning"></i> Reviews</div>
                    <div class="action-card-body" id="reviewSection"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        const json       = @Html.Raw(ViewBag.PropertyJson ?? "null");
        const isLoggedIn = @Html.Raw(isLoggedIn.ToString().ToLower());
        const token      = "@token";
        const userRole   = "@userRole";
        const canDeleteImages = (userRole === 'Agent' || userRole === 'Admin');

        let currentImg = 0;
        let images = [];

        const cityCoords = {
            'hyderabad':         [17.3850, 78.4867],
            'bangalore':         [12.9716, 77.5946],
            'bengaluru':         [12.9716, 77.5946],
            'mumbai':            [19.0760, 72.8777],
            'delhi':             [28.7041, 77.1025],
            'chennai':           [13.0827, 80.2707],
            'kolkata':           [22.5726, 88.3639],
            'pune':              [18.5204, 73.8567],
            'ahmedabad':         [23.0225, 72.5714],
            'jaipur':            [26.9124, 75.7873],
            'surat':             [21.1702, 72.8311],
            'lucknow':           [26.8467, 80.9462],
            'kanpur':            [26.4499, 80.3319],
            'nagpur':            [21.1458, 79.0882],
            'indore':            [22.7196, 75.8577],
            'bhopal':            [23.2599, 77.4126],
            'visakhapatnam':     [17.6868, 83.2185],
            'patna':             [25.5941, 85.1376],
            'vadodara':          [22.3072, 73.1812],
            'ghaziabad':         [28.6692, 77.4538],
            'coimbatore':        [11.0168, 76.9558],
            'kochi':             [9.9312,  76.2673],
            'ernakulam':         [9.9312,  76.2673],
            'thiruvananthapuram':[8.5241,  76.9366],
            'trivandrum':        [8.5241,  76.9366],
            'calicut':           [11.2588, 75.7804],
            'kozhikode':         [11.2588, 75.7804],
            'thrissur':          [10.5276, 76.2144],
            'kollam':            [8.8932,  76.6141],
            'palakkad':          [10.7867, 76.6548],
            'malappuram':        [11.0510, 76.0711],
            'kannur':            [11.8745, 75.3704],
            'alappuzha':         [9.4981,  76.3388],
            'kottayam':          [9.5916,  76.5222],
            'banjara hills':     [17.4126, 78.4371],
            'koramangala':       [12.9352, 77.6245],
            'andheri':           [19.1358, 72.8270],
            'gurgaon':           [28.4595, 77.0266],
            'gurugram':          [28.4595, 77.0266],
            'noida':             [28.5355, 77.3910],
            'chandigarh':        [30.7333, 76.7794],
            'mysore':            [12.2958, 76.6394],
            'mysuru':            [12.2958, 76.6394],
            'madurai':           [9.9252,  78.1198],
            'agra':              [27.1767, 78.0081],
            'varanasi':          [25.3176, 82.9739],
            'bhubaneswar':       [20.2961, 85.8245],
            'guwahati':          [26.1445, 91.7362],
            'dehradun':          [30.3165, 78.0322],
            'ranchi':            [23.3441, 85.3096],
            'raipur':            [21.2514, 81.6296],
        };

        function getCityCoords(text) {
            if (!text) return null;
            const key = text.toLowerCase().trim();
            if (cityCoords[key]) return cityCoords[key];
            for (const [k, v] of Object.entries(cityCoords)) {
                if (key.includes(k) || k.includes(key)) return v;
            }
            return null;
        }

        if (!json) {
            document.getElementById('loadingState').innerHTML = `
                <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                <h4>Property not found!</h4>
                <a href="/Home/Properties" class="btn btn-primary">Back to Properties</a>`;
        } else {
            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('propertyContent').style.display = 'block';

            images = (json.images && json.images.length > 0)
                ? json.images.map(i => ({ imageUrl: i.imageUrl, imageId: i.id }))
                : (json.imageUrls || []).map(url => ({ imageUrl: url, imageId: null }));

            document.getElementById('breadcrumbTitle').textContent = json.title;
            document.getElementById('detailTitle').textContent = json.title;
            document.getElementById('detailAddress').innerHTML =
                `<i class="fas fa-map-marker-alt me-1 text-primary"></i>${json.address}, ${json.city}`;
            document.getElementById('detailBadges').innerHTML = `
                <span class="badge bg-primary">${json.propertyType}</span>
                <span class="badge bg-success">${json.listingType}</span>
                <span class="badge bg-secondary">${json.status}</span>`;
            document.getElementById('detailPrice').textContent = '₹' + json.price.toLocaleString('en-IN');
            document.getElementById('detailDesc').textContent = json.description;
            document.getElementById('detailSpecs').innerHTML = [
                { icon:'fa-bed',            label:'Bedrooms',  val: json.bedrooms },
                { icon:'fa-bath',           label:'Bathrooms', val: json.bathrooms },
                { icon:'fa-ruler-combined', label:'Sq.Ft',     val: json.areaSqFt },
                { icon:'fa-eye',            label:'Views',     val: json.viewCount },
            ].map(s => `
                <div class="col-6 col-md-3">
                    <div class="spec-box">
                        <i class="fas ${s.icon} fa-lg text-primary mb-2"></i>
                        <h5 class="fw-bold mb-0">${s.val}</h5>
                        <small class="text-muted">${s.label}</small>
                    </div>
                </div>`).join('');

            renderCarousel();
            initMap();
            loadReviews();

         if (canDeleteImages) {
                document.getElementById('uploadSection').style.display = 'block';
                document.getElementById('inquiryCard').style.display   = 'none';
                document.getElementById('visitCard').style.display     = 'none';
                // Show favourites for agent too
                document.getElementById('favoriteSection').innerHTML = isLoggedIn ? `
                    <button class="btn btn-danger w-100" onclick="addFavorite('${json.id}')">
                        <i class="fas fa-heart me-2"></i>Add to Favorites
                    </button>
                    <div id="favResult" class="mt-2"></div>` : loginPrompt('Save this Property');
            } else {
                document.getElementById('favoriteSection').innerHTML = isLoggedIn ? `
                    <button class="btn btn-danger w-100" onclick="addFavorite('${json.id}')">
                        <i class="fas fa-heart me-2"></i>Add to Favorites
                    </button>
                    <div id="favResult" class="mt-2"></div>` : loginPrompt('Save this Property');

                document.getElementById('inquirySection').innerHTML = isLoggedIn ? `
                    <textarea class="form-control mb-2" id="inquiryMessage" rows="3"
                        placeholder="I am interested in this property..."></textarea>
                    <button class="btn btn-primary w-100" onclick="sendInquiry('${json.id}')">
                        <i class="fas fa-paper-plane me-2"></i>Send Message
                    </button>
                    <div id="inquiryResult" class="mt-2"></div>` : loginPrompt('Send an Inquiry');

                document.getElementById('visitSection').innerHTML = isLoggedIn ? `
                    <label class="form-label small fw-bold">Visit Date & Time</label>
                    <input type="datetime-local" class="form-control mb-2" id="visitDate" />
                    <label class="form-label small fw-bold">Notes (optional)</label>
                    <input type="text" class="form-control mb-3" id="visitNotes" placeholder="Any notes for the agent?" />
                    <button class="btn btn-success w-100" onclick="bookVisit('${json.id}')">
                        <i class="fas fa-calendar-check me-2"></i>Book Visit & Pay ₹1,000 Deposit
                    </button>
                    <div id="visitResult" class="mt-2"></div>` : loginPrompt('Book a Visit');
            }
        }
        // ── REVIEWS ──
        async function loadReviews() {
            if (!json.agentId) {
                document.getElementById('reviewCard').style.display = 'none';
                return;
            }

            try {
                const res  = await fetch('https://localhost:7056/api/Reviews');
                const all  = await res.json();
                const agentReviews = all.filter(r => r.agentId === json.agentId);

                const avgRating = agentReviews.length > 0
                    ? (agentReviews.reduce((s, r) => s + r.rating, 0) / agentReviews.length).toFixed(1)
                    : null;

                const stars = (rating) => {
                    let s = '';
                    for (let i = 1; i <= 5; i++) {
                        s += `<i class="fas fa-star" style="color:${i <= rating ? '#f59e0b' : '#e2e8f0'};font-size:14px;"></i>`;
                    }
                    return s;
                };

                const reviewsHtml = agentReviews.length > 0
                    ? agentReviews.slice(0, 3).map(r => `
                        <div class="border-bottom pb-2 mb-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>${stars(r.rating)}</div>
                                <small class="text-muted">${new Date(r.createdAt).toLocaleDateString()}</small>
                            </div>
                            <p class="text-muted small mb-0 mt-1">${r.comment}</p>
                        </div>`).join('')
                    : '<p class="text-muted small">No reviews yet.</p>';

                const avgHtml = avgRating
                    ? `<div class="d-flex align-items-center gap-2 mb-3">
                            <span class="fw-bold fs-4 text-warning">${avgRating}</span>
                            <div>${stars(Math.round(avgRating))}</div>
                            <small class="text-muted">(${agentReviews.length} review${agentReviews.length > 1 ? 's' : ''})</small>
                       </div>`
                    : '';

                // Write form only for buyers
                const formHtml = (isLoggedIn && userRole !== 'Agent' && userRole !== 'Admin') ? `
                    <hr/>
                    <p class="fw-bold small mb-2">Leave a Review</p>
                    <div class="d-flex gap-1 mb-2" id="starPicker">
                        ${[1,2,3,4,5].map(i => `
                            <i class="fas fa-star fa-lg"
                               style="cursor:pointer;color:#e2e8f0;"
                               onmouseover="hoverStar(${i})"
                               onmouseout="resetStars()"
                               onclick="selectStar(${i})"
                               id="star-${i}"></i>`).join('')}
                    </div>
                    <input type="hidden" id="selectedRating" value="0" />
                    <textarea class="form-control form-control-sm mb-2" id="reviewComment"
                        rows="2" placeholder="Write your review..."></textarea>
                    <button class="btn btn-warning btn-sm w-100" onclick="submitReview()">
                        <i class="fas fa-star me-1"></i>Submit Review
                    </button>
                    <div id="reviewResult" class="mt-2"></div>` : '';

                document.getElementById('reviewSection').innerHTML =
                    avgHtml + reviewsHtml + formHtml;

            } catch(e) {
                console.error('Reviews error:', e);
                document.getElementById('reviewCard').style.display = 'none';
            }
        }

        function hoverStar(n) {
            for (let i = 1; i <= 5; i++) {
                const s = document.getElementById('star-' + i);
                if (s) s.style.color = i <= n ? '#f59e0b' : '#e2e8f0';
            }
        }

        function resetStars() {
            const selected = parseInt(document.getElementById('selectedRating')?.value || '0');
            for (let i = 1; i <= 5; i++) {
                const s = document.getElementById('star-' + i);
                if (s) s.style.color = i <= selected ? '#f59e0b' : '#e2e8f0';
            }
        }

        function selectStar(n) {
            document.getElementById('selectedRating').value = n;
            resetStars();
        }

        async function submitReview() {
            const rating  = parseInt(document.getElementById('selectedRating').value);
            const comment = document.getElementById('reviewComment').value;
            if (rating === 0) { alert('Please select a star rating!'); return; }
            if (!comment)     { alert('Please write a comment!'); return; }

            const r = await fetch('https://localhost:7056/api/Reviews', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify({ agentId: json.agentId, rating, comment })
            });

            if (r.ok) {
                document.getElementById('reviewResult').innerHTML =
                    '<div class="alert alert-success py-1 small">⭐ Review submitted!</div>';
                setTimeout(() => loadReviews(), 1500);
            } else {
                document.getElementById('reviewResult').innerHTML =
                    '<div class="alert alert-danger py-1 small">❌ Failed to submit.</div>';
            }
        }
        async function initMap() {
            let lat = json.latitude;
            let lng = json.longitude;

            if (!lat || !lng || lat === 0 || lng === 0) {
                // Step 1: hardcoded city list
                const coords = getCityCoords(json.city) || getCityCoords(json.address);
                if (coords) {
                    lat = coords[0];
                    lng = coords[1];
                } else {
                    // Step 2: Nominatim API with 3 query formats
                    try {
                        const queries = [
                            encodeURIComponent(json.city),
                            encodeURIComponent(json.city + ' India'),
                            encodeURIComponent(json.address + ' ' + json.city),
                        ];
                        for (const q of queries) {
                            const res  = await fetch('https://nominatim.openstreetmap.org/search?q=' + q + '&format=json&limit=1');
                            const data = await res.json();
                            console.log('Nominatim:', q, data);
                            if (data && data.length > 0) {
                                lat = parseFloat(data[0].lat);
                                lng = parseFloat(data[0].lon);
                                break;
                            }
                            await new Promise(r => setTimeout(r, 1000));
                        }
                    } catch(e) {
                        console.warn('Nominatim error:', e);
                    }
                    // Step 3: fallback to India center
                    if (!lat || !lng || lat === 0 || lng === 0) {
                        lat = 20.5937;
                        lng = 78.9629;
                    }
                }
            }

            setTimeout(() => {
                const zoom = (lat === 20.5937 && lng === 78.9629) ? 5 : 14;
                const map = L.map('map').setView([lat, lng], zoom);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors',
                    maxZoom: 19
                }).addTo(map);
                L.marker([lat, lng])
                 .addTo(map)
                 .bindPopup('<b>' + json.title + '</b><br>' + json.address)
                 .openPopup();
            }, 400);
        }

        function loginPrompt(action) {
            return '<p class="text-muted small mb-2">Please login to ' + action + '</p>' +
                '<a href="/Auth/Login" class="btn btn-outline-primary w-100">' +
                '<i class="fas fa-sign-in-alt me-2"></i>Login</a>';
        }

        function getImageSrc(imageUrl) {
            return imageUrl.startsWith('http')
                ? imageUrl
                : 'https://localhost:7056' + (imageUrl.startsWith('/') ? '' : '/') + imageUrl;
        }

        function renderCarousel() {
            const container = document.getElementById('carouselContainer');
            if (!images.length) {
                container.innerHTML =
                    '<div class="no-image-placeholder">' +
                    '<i class="fas fa-home fa-4x mb-3"></i>' +
                    '<p class="mb-0">No images uploaded yet</p>' +
                    (canDeleteImages ? '<small class="mt-1">Use the upload panel to add images</small>' : '') +
                    '</div>';
                return;
            }

            const imgTags = images.map((img, i) =>
                '<img class="carousel-img ' + (i===0?'active':'') + '" src="' + getImageSrc(img.imageUrl) + '" alt="img' + (i+1) + '" />'
            ).join('');

            const dots = images.map((_,i) =>
                '<span class="carousel-dot ' + (i===0?'active':'') + '" onclick="goTo(' + i + ')"></span>'
            ).join('');

            const thumbsHtml = images.map((img, i) => {
                const src = getImageSrc(img.imageUrl);
                const xBtn = (canDeleteImages && img.imageId)
                    ? '<button onclick="deleteImage(event,\'' + img.imageId + '\',' + i + ')" title="Delete" ' +
                      'style="position:absolute;top:-8px;right:-8px;width:22px;height:22px;' +
                      'background:#dc2626;color:white;border:2px solid white;border-radius:50%;' +
                      'font-size:12px;font-weight:bold;cursor:pointer;display:flex;' +
                      'align-items:center;justify-content:center;z-index:100;padding:0;' +
                      'box-shadow:0 2px 6px rgba(0,0,0,0.5);">✕</button>'
                    : '';
                return '<div style="position:relative;flex-shrink:0;display:inline-block;">' +
                    '<img src="' + src + '" onclick="goTo(' + i + ')" id="thumb-' + i + '" ' +
                    'style="width:72px;height:54px;object-fit:cover;border-radius:8px;cursor:pointer;display:block;' +
                    'border:2px solid ' + (i===0?'#2563eb':'#e2e8f0') + ';" />' +
                    xBtn + '</div>';
            }).join('');

            container.innerHTML =
                '<div class="carousel-wrapper">' +
                imgTags +
                (images.length > 1 ?
                    '<button class="carousel-btn prev" onclick="prevImg()"><i class="fas fa-chevron-left"></i></button>' +
                    '<button class="carousel-btn next" onclick="nextImg()"><i class="fas fa-chevron-right"></i></button>' +
                    '<div class="carousel-dots">' + dots + '</div>' : '') +
                '<div class="img-count-badge"><i class="fas fa-images me-1"></i>' + images.length + ' photo' + (images.length>1?'s':'') + '</div>' +
                '</div>' +
                '<div style="display:flex;gap:10px;margin-top:10px;overflow-x:auto;padding:4px 2px;">' +
                thumbsHtml + '</div>';
        }

        function goTo(n) {
            document.querySelectorAll('.carousel-img').forEach((el,i) => el.classList.toggle('active', i===n));
            document.querySelectorAll('.carousel-dot').forEach((el,i) => el.classList.toggle('active', i===n));
            images.forEach((_, i) => {
                const th = document.getElementById('thumb-' + i);
                if (th) th.style.border = '2px solid ' + (i===n?'#2563eb':'#e2e8f0');
            });
            currentImg = n;
        }
        function nextImg() { goTo((currentImg + 1) % images.length); }
        function prevImg() { goTo((currentImg - 1 + images.length) % images.length); }
        setInterval(() => { if (images.length > 1) nextImg(); }, 4000);

        async function deleteImage(event, imageId, index) {
            event.stopPropagation();
            if (!confirm('Delete this image? Cannot be undone.')) return;
            const btn = event.currentTarget;
            const orig = btn.textContent;
            btn.disabled = true;
            btn.textContent = '…';
            try {
                const r = await fetch(
                    'https://localhost:7056/api/Properties/' + json.id + '/images/' + imageId,
                    { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } }
                );
                if (r.ok) {
                    images.splice(index, 1);
                    currentImg = Math.min(currentImg, Math.max(0, images.length - 1));
                    renderCarousel();
                    if (images.length > 0) goTo(currentImg);
                } else {
                    alert('Failed to delete. Status: ' + r.status);
                    btn.disabled = false; btn.textContent = orig;
                }
            } catch(e) {
                alert('Network error.');
                btn.disabled = false; btn.textContent = orig;
            }
        }

        async function handleImageUpload(input) {
            const files = Array.from(input.files);
            if (!files.length) return;
            const prog = document.getElementById('uploadProgress');
            prog.innerHTML = '<div class="alert alert-info py-2"><i class="fas fa-spinner fa-spin me-2"></i>Uploading ' + files.length + ' image(s)...</div>';
            let success = 0;
            for (const file of files) {
                const fd = new FormData();
                fd.append('file', file);
                try {
                    const r = await fetch('https://localhost:7056/api/Properties/' + json.id + '/images',
                        { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd });
                    if (r.ok) success++;
                } catch(e) { console.error(e); }
            }
            if (success > 0) {
                prog.innerHTML = '<div class="alert alert-success py-2">✅ ' + success + ' image(s) uploaded! Reloading...</div>';
                setTimeout(() => window.location.reload(), 1500);
            } else {
                prog.innerHTML = '<div class="alert alert-danger py-2">❌ Upload failed!</div>';
            }
        }

        async function addFavorite(propertyId) {
            const r = await fetch('https://localhost:7056/api/Favorites', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify({ propertyId })
            });
            document.getElementById('favResult').innerHTML = r.ok
                ? '<div class="alert alert-success py-1 small">❤️ Saved!</div>'
                : '<div class="alert alert-danger py-1 small">❌ Already in favorites</div>';
        }

        async function sendInquiry(propertyId) {
            const message = document.getElementById('inquiryMessage').value;
            if (!message) { alert('Please enter a message!'); return; }
            const r = await fetch('https://localhost:7056/api/Inquiries', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify({ propertyId, message })
            });
            document.getElementById('inquiryResult').innerHTML = r.ok
                ? '<div class="alert alert-success py-1 small">✅ Inquiry sent!</div>'
                : '<div class="alert alert-danger py-1 small">❌ Failed to send.</div>';
        }

        async function bookVisit(propertyId) {
            const visitDate = document.getElementById('visitDate').value;
            const notes = document.getElementById('visitNotes').value;
            if (!visitDate) { alert('Please select a date!'); return; }
            const r = await fetch('https://localhost:7056/api/VisitBookings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify({ propertyId, visitDate, notes })
            });
            if (r.ok) {
                const bookingData = await r.json();
                document.getElementById('visitResult').innerHTML =
                    '<div class="alert alert-success py-1 small">✅ Visit booked! Opening payment...</div>';
                setTimeout(() => payDeposit(bookingData.id, 1000), 600);
            } else {
                document.getElementById('visitResult').innerHTML =
                    '<div class="alert alert-danger py-1 small">❌ Failed to book.</div>';
            }
        }

        async function payDeposit(bookingId, amount) {
            const orderRes = await fetch('https://localhost:7056/api/Payments/create-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify({ bookingId, amount })
            });
            if (!orderRes.ok) return;
            const order = await orderRes.json();
            new Razorpay({
                key: order.keyId, amount: order.amount, currency: order.currency,
                name: 'RealEstate', description: 'Visit Booking Deposit', order_id: order.orderId,
                handler: async function(response) {
                    const v = await fetch('https://localhost:7056/api/Payments/verify', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                        body: JSON.stringify({
                            bookingId,
                            razorpayOrderId: response.razorpay_order_id,
                            razorpayPaymentId: response.razorpay_payment_id,
                            razorpaySignature: response.razorpay_signature
                        })
                    });
                    document.getElementById('visitResult').innerHTML = v.ok
                        ? '<div class="alert alert-success py-1 small">💳 Payment confirmed!</div>'
                        : '<div class="alert alert-warning py-1 small">⚠️ Booked but payment verification failed.</div>';
                },
                prefill: { name: '@ViewBag.FullName', email: '@ViewBag.Email' },
                theme: { color: '#2563eb' }
            }).open();
        }
    </script>
}